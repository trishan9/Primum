# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Hard ceiling on cumulative Claude API spend recorded in the local ledger (USD).
PRIMUM_BUDGET_USD=15

# Generator used for experiments and for the live system (the confidence model is
# calibrated for this model, so change it only if you re-run the experiments).
PRIMUM_LLM_MODEL=claude-haiku-5-5
